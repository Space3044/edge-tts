# Copy to .dev.vars for `npx wrangler dev` and fill in real values.
# .dev.vars is git-ignored; never commit real secrets.

# AES-256-GCM key used to encrypt provider API keys before they are stored in D1.
# Must be base64 of exactly 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this value makes existing rows undecryptable: re-save the keys afterwards.
SECRETS_ENCRYPTION_KEY=3MA8dqfnN1veywbjKPVE9hDwIq2Ra5TXvsTThon+SEc=

# Bearer token required by PUT /api/providers/:provider.
# Without it the settings panel is read-only.
ADMIN_TOKEN=change-me-local-admin-token

# Microsoft (Azure AI Speech) uses OAuth instead of an API key: register an app
# in Entra ID, add https://<your-domain>/api/microsoft/callback as a redirect
# URI, then paste the client id/secret here. MICROSOFT_TENANT defaults to
# "common"; use your tenant id for a single-tenant app.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# Optional fallbacks, used when D1 has no key for that provider.
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# GEMINI_API_KEY=
